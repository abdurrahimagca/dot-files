{
  "cli_default_open_behavior": "new_window",
  "diff_view_style": "unified",
  "agent_servers": {
    "gemini": { "type": "registry" },
    "codex-acp": { "type": "registry" },
    "claude-acp": { "type": "registry" },
  },
  "which_key": { "enabled": true },
  "autosave": {
    "after_delay": { "milliseconds": 1000 },
  },
  "text_rendering_mode": "platform_default",
  "session": { "trust_all_worktrees": true },
  "edit_predictions": { "provider": "zed" },

  // --- FONT ---
  "buffer_font_family": "Geist Mono",
  "buffer_font_weight": 500, // Medium = 500
  "buffer_font_features": {
    "calt": true,
    "ss01": true,
    "ss02": true,
    "ss03": true,
    "ss04": true,
    "ss05": true,
    "ss06": true,
    "ss07": true,
    "ss08": true,
    "ss09": true,
    "ss10": true,
  },
  "ui_font_family": "Geist Mono",
  "ui_font_size": 16,
  "buffer_font_size": 17.0,
  "buffer_line_height": "comfortable",
  "use_system_window_tabs": true,

  // --- ICON THEME: extensions'dan "Catppuccin Icons" veya "Material Icons" kur ---
  "icon_theme": "Material Icon Theme",

  "relative_line_numbers": "enabled",
  "outline_panel": { "dock": "right" },
  "max_tabs": 3,
  "project_panel": {
    "entry_spacing": "standard",
    "scrollbar": { "show": "auto" },
    "dock": "right",
  },
  "git_panel": {
    "tree_view": true,
    "dock": "right",
  },
  "agent": {
    "commit_message_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-4-5",
    },
    "dock": "left",
    "model_parameters": [],
  },
  "notification_panel": { "dock": "left" },
  "collaboration_panel": { "dock": "right" },
  "terminal": {
    "flexible": true,
    "show_count_badge": true,
    "dock": "left",
    "font_family": "Geist Mono",
    "font_size": 15,
  },
  "vim_mode": true,
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "Gruvbox Dark Hard",
  },
  "vim": {
    "use_system_clipboard": "always",
    "cursor_shape": { "insert": "hollow" },
  },
  "languages": {
    "Go": {
      "language_servers": ["gopls", "golangci-lint"],
    },
  },
}
