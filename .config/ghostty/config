theme = "Gruvbox Dark"
font-family = "JetBrains Mono"
font-size = 16
adjust-cell-height=20%
font-style = "Regular"
font-feature = "calt, ss01, ss02, ss03, ss04, ss05, ss06, ss07, ss08,ss09,ss10"
shell-integration = zsh
shell-integration-features = no-cursor
cursor-style = block
cursor-style-blink = true
macos-titlebar-style = hidden
macos-non-native-fullscreen = true
macos-option-as-alt = true
window-padding-x = 15 
window-padding-y = 30
copy-on-select=true
scroll-to-bottom=no-output
